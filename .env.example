# Put this file's contents in recipe.env. Chrome can read recipe.env.
# It often cannot see a file named .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# A model on this computer. Uncomment both lines to use it instead of OpenRouter.
# RECIPE_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
