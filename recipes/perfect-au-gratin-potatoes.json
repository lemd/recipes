    "stepGroups": [
      {
        "id": "step-group-1",
        "name": null,
        "steps": [
          {
            "id": "step-1",
            "text": "Preheat the oven to 350 degrees F.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": {
              "celsius": {
                "value": 177,
                "valueMax": null
              },
              "fahrenheit": {
                "value": 350,
                "valueMax": null
              }
            }
          },
          {
            "id": "step-2",
            "text": "Heat the butter in a large saucepan over medium-high heat and add the onions and cook until soft and translucent, 5-6 minutes. Add the garlic and cook for another minute.",
            "durationMinutes": 6,
            "durationMinutesMax": 7,
            "temperature": null
          },
          {
            "id": "step-3",
            "text": "Add the flour and stir to combine. Cook for a minute or two.",
            "durationMinutes": 1,
            "durationMinutesMax": 2,
            "temperature": null
          },
          {
            "id": "step-4",
            "text": "Add the milk and cream, stirring continually to prevent clumping. Slowly bring to a boil, reduce the heat and simmer until slightly thickened.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-5",
            "text": "Add the cheddar cheese, parmesan cheese and salt and stir until melted.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-6",
            "text": "Add the potatoes and stir until thoroughly combined.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-7",
            "text": "Pour the mixture into a 2 quart casserole dish. Sprinkle with the remaining Parmesan cheese. Cover with foil.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-8",
            "text": "Bake for 1 hour or until the potatoes are tender (time can vary depending on how thickly the potatoes are sliced). Stick a sharp paring knife through the potatoes to check for doneness.",
            "durationMinutes": 60,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-9",
            "text": "Uncover and bake for another 20 minutes or until the top is lightly browned and to enable excess moisture to evaporate.",
            "durationMinutes": 20,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-10",
            "text": "Let sit for about 5 minutes before serving (if you used a lower starch potato variety like Yukon Gold it will be \"soupier\" and may need to sit a few minutes longer to enable the excess liquid to absorb). Sprinkle with some chopped parsley for garnish if desired.",
            "durationMinutes": 5,
            "durationMinutesMax": null,
            "temperature": null
          }
        ]
      }
    ],
