      {
        "id": "step-group-1",
        "name": null,
        "steps": [
          {
            "id": "step-1",
            "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease a 2-quart casserole dish with butter.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": {
              "celsius": {
                "value": 204,
                "valueMax": null
              },
              "fahrenheit": {
                "value": 400,
                "valueMax": null
              }
            }
          },
          {
            "id": "step-2",
            "text": "Layer 1/2 of the potatoes in the bottom of the prepared casserole dish; season with salt and pepper.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-3",
            "text": "Layer onion slices over top, then top with remaining potatoes. Season again with salt and pepper.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-4",
            "text": "Melt butter in a medium saucepan over medium heat. Whisk in flour and salt; cook, whisking constantly, until raw flour flavor has cooked off, about 1 minute.",
            "durationMinutes": 1,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-5",
            "text": "Gradually add milk, about 1/4 cup at a time, whisking well after each addition to incorporate; the gradual addition and whisking of milk will help avoid lumps in your sauce.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-6",
            "text": "Cook, whisking constantly, until the mixture has thickened, 3 to 5 minutes.",
            "durationMinutes": 3,
            "durationMinutesMax": 5,
            "temperature": null
          },
          {
            "id": "step-7",
            "text": "Stir in freshly shredded cheese; cook, stirring constantly, until melted and smooth, 30 to 60 seconds.",
            "durationMinutes": 0.5,
            "durationMinutesMax": 1,
            "temperature": null
          },
          {
            "id": "step-8",
            "text": "Pour cheese sauce evenly over potatoes. Cover tightly with aluminum foil.",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-9",
            "text": "Bake in the preheated oven until sauce is bubbly and a knife slides easily through the potatoes, about 1 ½ hours.",
            "durationMinutes": 90,
            "durationMinutesMax": null,
            "temperature": null
          },
          {
            "id": "step-10",
            "text": "Let stand briefly before serving so the sauce can settle. Enjoy!",
            "durationMinutes": null,
            "durationMinutesMax": null,
            "temperature": null
          }
        ]
      }
    ],
